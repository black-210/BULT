module bult::blue;

struct DetectionRule {
    rule_id: str,
    name: str,
    pattern: str,
    severity: i32,
}

struct BlueAlert {
    alert_id: str,
    rule_id: str,
    source_event: str,
    severity: i32,
    timestamp: i64,
}

struct IntegrityStatus {
    total_files: u32,
    matching_files: u32,
    drift_detected: bool,
}

fn evaluate_manifest_drift(total: u32, matching: u32) -> own<IntegrityStatus> {
    let has_drift: bool = (total != matching);
    let status: own<IntegrityStatus> = IntegrityStatus {
        total_files: total,
        matching_files: matching,
        drift_detected: has_drift,
    };
    return move(status);
}
