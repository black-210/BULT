module bult::chemistry;

struct ChemicalAnalysis {
    formula: str,
    molecular_mass: f64,
    element_count: u32,
    carbon_fraction: f64,
    hydrogen_fraction: f64,
}

struct SpectralPeak {
    position: f64,
    intensity: f64,
    fwhm: f64,
    snr: f64,
}

fn compute_mass_fraction(element_mass: f64, total_mass: f64) -> f64 {
    if (total_mass <= 0.0) {
        return 0.0;
    }
    return (element_mass / total_mass) * 100.0;
}
